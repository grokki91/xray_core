{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "in-selftest",
      "listen": "/run/xm/selftest.sock,0600",
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "203.0.113.10",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-4000-8000-0000000000aa",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "example.com",
          "fingerprint": "chrome",
          "publicKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "shortId": "0123456789abcdef"
        },
        "xhttpSettings": {
          "path": "/example",
          "mode": "auto"
        }
      }
    }
  ]
}
